<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Controllers.AddMechanicController"
            stylesheets="@styles.css" styleClass="gradient-pane">

    <VBox spacing="15" alignment="CENTER" prefWidth="450" prefHeight="500" styleClass="form-container"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="Add Mechanic" styleClass="form-title"/>

        <Label text="Mechanic Name:" styleClass="form-label"/>
        <TextField fx:id="nameMechanicField" promptText="Enter mechanic name" styleClass="form-input"/>

        <Label text="Speciality:" styleClass="form-label"/>
        <ComboBox fx:id="specialityMechanicComboBox"/>

        <Label text="Email:" styleClass="form-label"/>
        <TextField fx:id="emailMechanicField" promptText="Enter email" styleClass="form-input"/>

        <Label text="Cars Repaired:" styleClass="form-label"/>
        <TextField fx:id="carsRepairedField" promptText="Enter number of cars repaired" styleClass="form-input"/>

        <Label text="Upload Mechanic Image:" styleClass="form-label"/>
        <Button fx:id="uploadImageButton" text="Choose Image" onAction="#uploadImage" styleClass="primary-button"/>
        <ImageView fx:id="mechanicImageView" fitWidth="150" fitHeight="150"/>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="saveButton" text="Save" onAction="#saveMechanic" styleClass="primary-button"/>
            <Button fx:id="cancelButton" text="Cancel" onAction="#cancel" styleClass="delete-button"/>
        </HBox>

    </VBox>

</AnchorPane>
