<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Controllers.ShowDetailsAssignmentController"
            stylesheets="@styles.css" styleClass="gradient-pane">

    <VBox spacing="12" alignment="CENTER" prefWidth="550" prefHeight="750" styleClass="form-container"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="Assignment Details" styleClass="form-title"/>

        <!-- Assignment Details -->
        <Label text="Description:" styleClass="form-label"/>
        <Label fx:id="descriptionLabel" styleClass="form-value"/>

        <Label text="Status:" styleClass="form-label"/>
        <Label fx:id="statusLabel" styleClass="form-value"/>

        <Label text="Assignment Date:" styleClass="form-label"/>
        <Label fx:id="dateLabel" styleClass="form-value"/>

        <Label text="Mechanics Assigned:" styleClass="form-label"/>
        <ListView fx:id="mechanicListView" styleClass="form-list" prefHeight="80"/>

        <!-- Car Details Section -->
        <Label text="Car Details" styleClass="form-title"/>

        <ImageView fx:id="carImageView" fitWidth="200" fitHeight="120"/>

        <HBox spacing="10">
            <VBox spacing="8">
                <Label text="Model:" styleClass="form-label"/>
                <Label fx:id="carModelLabel" styleClass="form-value"/>

                <Label text="Brand:" styleClass="form-label"/>
                <Label fx:id="carBrandLabel" styleClass="form-value"/>

                <Label text="Year:" styleClass="form-label"/>
                <Label fx:id="carYearLabel" styleClass="form-value"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Price:" styleClass="form-label"/>
                <Label fx:id="carPriceLabel" styleClass="form-value"/>

                <Label text="Status:" styleClass="form-label"/>
                <Label fx:id="carStatusLabel" styleClass="form-value"/>

                <Label text="Kilometrage:" styleClass="form-label"/>
                <Label fx:id="carKilometrageLabel" styleClass="form-value"/>
            </VBox>
        </HBox>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="closeButton" text="Close" onAction="#closeWindow" styleClass="delete-button"/>
        </HBox>

    </VBox>

</AnchorPane>
