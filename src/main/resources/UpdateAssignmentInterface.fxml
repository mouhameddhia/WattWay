<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?> <!-- Add this line -->

<?import javafx.scene.control.Tooltip?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.Controllers.UpdateAssignmentController"
            stylesheets="@styles.css" styleClass="gradient-pane">

    <VBox spacing="15" alignment="CENTER" prefWidth="500" prefHeight="700" styleClass="form-container"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="Update Assignment" styleClass="form-title" />

        <Label text="Description:" styleClass="form-label"/>
        <HBox spacing="5" alignment="CENTER_LEFT">
            <TextField fx:id="descriptionAssignmentField"
                       promptText="Enter assignment description"
                       styleClass="form-input" HBox.hgrow="ALWAYS"/>
            <Button text="🎤" onAction="#handleRecordButton" styleClass="mic-button">
                <tooltip>
                    <Tooltip text="Start/Stop recording voice" />
                </tooltip>
            </Button>
            <Button text="📝" onAction="#handleTranscribeButton" styleClass="mic-button">
                <tooltip>
                    <Tooltip text="Transcribe audio" />
                </tooltip>
            </Button>
        </HBox>


        <Label text="Status:" styleClass="form-label"/>
        <ComboBox fx:id="statusAssignmentComboBox" styleClass="form-input"/>

        <Label text="Select Car:" styleClass="form-label"/>
        <ComboBox fx:id="carIdComboBox" promptText="Select User ID" styleClass="form-input" />

        <Label text="Assignment Date:" styleClass="form-label"/> <!-- Add this line -->
        <DatePicker fx:id="dateAssignmentPicker" styleClass="form-input"/> <!-- Add this line -->

        <Label text="Search Mechanic:" styleClass="form-label"/>
        <TextField fx:id="searchMechanicField" promptText="Enter mechanic name" styleClass="form-input"/>

        <ListView fx:id="mechanicListView" prefHeight="150" styleClass="form-listview"/>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="saveButton" text="Save" onAction="#saveAssignment" styleClass="primary-button"/>
            <Button fx:id="cancelButton" text="Cancel" onAction="#cancel" styleClass="delete-button"/>
        </HBox>

    </VBox>

</AnchorPane>